# Dist defaults (not a conffile). Same KEY=value syntax as
# /etc/default/bootstash. This file is the full default set (also
# embedded). Override in /etc/default/bootstash; do not edit this file.
# See bootstash(5). Empty means unset / derived at runtime.

DATA=/var/lib/bootstash
BIND=127.0.0.1:8080
PUBLIC_URL=
ADMIN_USERS=

TLS=auto
TLS_CERT=
TLS_KEY=
CERT_NAME=

PAM_SERVICE=bootstashd
UNIX_GROUP=bootstash
MAX_UPLOAD=32MiB
SHARED_WRITABLE=no

OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_CRYPTO=
