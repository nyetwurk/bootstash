# Dist defaults (not a conffile). Same KEY=value syntax as
# /etc/default/bootstash. Packaged operator keys (also embedded).
# Override in /etc/default/bootstash; do not edit this file.
# OIDC client id/secret are /etc/bootstash/oidc-google.json, not here.
# OIDC_CRYPTO is $DATA/state/crypto.key when unset; not here.
# See bootstash(5). Empty means unset / derived at runtime.

DATA=/var/lib/bootstash
LISTEN=127.0.0.1:8080
PUBLIC_URL=
ADMIN_USERS=

TLS=auto
TLS_CERT=
TLS_KEY=
CERT_NAME=

PAM_SERVICE=bootstashd
UNIX_GROUP=bootstash
MAX_UPLOAD=32MiB
