# Dist defaults (not a conffile). Same KEY=value syntax as
# /etc/default/bootstash. Override there; do not edit this file.
# See bootstash(5). PUBLIC_ORIGIN defaults from CERT_NAME (else hostname -f).
# The hook copies one live/ lineage (CERT_NAME, hostname -f, or the only one).
DATA=/var/lib/bootstash
PAM_SERVICE=bootstashd
BIND=127.0.0.1:8080
MAX_UPLOAD=33554432
SHARED_WRITABLE=0
UNIX_GROUP=bootstash
