#
# Certbot deploy hook. Copies one lineage from live/ into
# /etc/bootstash/certs/<name>. Not an ACME client.
#
#   (no args)  RENEWED_LINEAGE if it is the chosen name, or
#              already installed under certs/ when no name is chosen
#   sync       copy the chosen live/ lineage (package configure)
#
# Chosen name, in order: CERT_NAME, PUBLIC_URL host,
# live/$(hostname -f), the only live/ lineage.
#
# TLS=no: do not copy; remove dest PEMs (unused private key).
# live/ is untouched. Does not rewrite the operator file.
set -eu

etc=${BOOTSTASH_ETC:-/etc/bootstash}
op=${BOOTSTASH_DEFAULT:-/etc/default/bootstash}
live=${BOOTSTASH_LIVE:-/etc/letsencrypt/live}
certs=$etc/certs
group=${BOOTSTASH_GROUP:-bootstash}
fqdn=${BOOTSTASH_FQDN:-$(hostname -f 2>/dev/null || true)}

# Production: missing tree or group means this box is not ready.
# Tests set BOOTSTASH_ETC and skip that gate.
if [ -z "${BOOTSTASH_ETC+x}" ]; then
	[ -d "$etc" ] || exit 0
	getent group "$group" >/dev/null 2>&1 || exit 0
fi

# Certbot deploy hooks (keep stderr empty unless we want a warning):
#   exit != 0  → WARNING "reported error code" (real failure; set -e)
#   anything on stderr → WARNING "ran with error output" even on exit 0
#   stdout     → "ran with output" (not a warning)
# Merge this shell's stderr into stdout so log lines and
# `systemctl reload` are visible without looking like an error.
# `exec 2>&1 | logger` does not do that: the pipe only covers that
# one command.
exec 2>&1

log() {
	echo "bootstash: $*"
}

# Last uncommented KEY=value.
last_key() {
	key=$1
	[ -r "$op" ] || return 0
	val=
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		'' | '#'*) continue ;;
		esac
		k=${line%%=*}
		v=${line#*=}
		k=$(printf '%s' "$k" | tr -d ' \t')
		[ "$k" = "$key" ] || continue
		v=$(printf '%s' "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//;s/^'\''//;s/'\''$//')
		val=$v
	done <"$op"
	printf '%s' "$val"
}

tls_off() {
	v=$(printf '%s' "$(last_key TLS)" | tr 'A-Z' 'a-z')
	case $v in
	0 | false | no | off) return 0 ;;
	esac
	return 1
}

safe_name() {
	case $1 in
	'' | . | .. | *[!A-Za-z0-9.-]*) return 1 ;;
	esac
	return 0
}

purge_dest_certs() {
	[ -d "$certs" ] || return 0
	for d in "$certs"/*; do
		[ -e "$d" ] || continue
		[ -L "$d" ] && continue
		[ -d "$d" ] || continue
		name=$(basename "$d")
		safe_name "$name" || continue
		if [ -e "$d/fullchain.pem" ] || [ -e "$d/privkey.pem" ]; then
			rm -f "$d/fullchain.pem" "$d/privkey.pem"
			log "removed PEMs in $d (TLS=no; unused private key)"
		fi
		rmdir "$d" 2>/dev/null || true
	done
}

origin_host() {
	u=$(last_key PUBLIC_URL)
	[ -n "$u" ] || return 0
	u=${u#http://}
	u=${u#https://}
	u=${u%%/*}
	case $u in
	'['*)
		u=${u#\[}
		u=${u%%]*}
		;;
	*)
		u=${u%%:*}
		;;
	esac
	printf '%s' "$u"
}

list_live() {
	[ -d "$live" ] || return 0
	for d in "$live"/*; do
		[ -d "$d" ] || continue
		name=$(basename "$d")
		[ "$name" != README ] || continue
		[ -f "$d/fullchain.pem" ] && [ -f "$d/privkey.pem" ] || continue
		printf '%s\n' "$name"
	done
}

cert_name=$(last_key CERT_NAME)
origin=$(origin_host)
chosen=
how=
if [ -n "$cert_name" ]; then
	chosen=$cert_name
	how=CERT_NAME
elif [ -n "$origin" ]; then
	chosen=$origin
	how=PUBLIC_URL
elif [ -n "$fqdn" ] && [ -f "$live/$fqdn/fullchain.pem" ]; then
	chosen=$fqdn
	how='hostname -f'
else
	n=0
	only=
	while IFS= read -r name || [ -n "$name" ]; do
		[ -n "$name" ] || continue
		n=$((n + 1))
		only=$name
	done <<EOF
$(list_live)
EOF
	if [ "$n" = 1 ]; then
		chosen=$only
		how='only live/ lineage'
	fi
fi

wanted() {
	name=$1
	[ -n "$name" ] || return 1
	[ -n "$chosen" ] && [ "$name" = "$chosen" ] && return 0
	# No chosen name: keep an already-installed dest fresh on renew.
	[ -z "$chosen" ] && [ -f "$certs/$name/fullchain.pem" ] && [ -f "$certs/$name/privkey.pem" ]
}

install_pair() {
	src=$1
	dest=$2
	if [ "$(id -u)" = 0 ] && getent group "$group" >/dev/null 2>&1; then
		install -d -m 0750 -o root -g "$group" "$certs"
		install -d -m 0750 -o root -g "$group" "$dest"
		install -m 0640 -o root -g "$group" "$src/fullchain.pem" "$dest/fullchain.pem"
		install -m 0640 -o root -g "$group" "$src/privkey.pem" "$dest/privkey.pem"
		return 0
	fi
	install -d -m 0750 "$certs"
	install -d -m 0750 "$dest"
	install -m 0640 "$src/fullchain.pem" "$dest/fullchain.pem"
	install -m 0640 "$src/privkey.pem" "$dest/privkey.pem"
}

deploy_lineage() {
	lineage=$1
	name=$(basename "$lineage")
	safe_name "$name" || return 1
	[ -f "$lineage/fullchain.pem" ] && [ -f "$lineage/privkey.pem" ] || return 1
	wanted "$name" || return 1
	install_pair "$lineage" "$certs/$name"
	why=$how
	[ -n "$why" ] || why='already in certs/'
	log "copied $lineage -> $certs/$name ($why)"
}

maybe_reload() {
	[ -z "${BOOTSTASH_ETC+x}" ] || return 0
	if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet bootstash; then
		systemctl reload bootstash || true
	fi
}

sync_live() {
	if [ -n "$chosen" ]; then
		log "using $chosen ($how)"
		deploy_lineage "$live/$chosen" && return 0
	fi
	log "no live/ lineage to copy (hostname -f=${fqdn:-unset} CERT_NAME=${cert_name:-unset} PUBLIC_URL host=${origin:-unset})"
	avail=$(list_live | tr '\n' ' ')
	if [ -n "$avail" ]; then
		log "live/ has: $avail"
		log "set CERT_NAME=<lineage> in $op (several lineages; will not guess)"
	elif [ ! -d "$live" ]; then
		log "no $live"
	else
		log "no lineages in $live"
	fi
}

if tls_off; then
	log "TLS=no; not copying live/ into $certs"
	purge_dest_certs
	maybe_reload
	exit 0
fi

if [ "${1:-}" = sync ]; then
	sync_live
	maybe_reload
	exit 0
fi

lineage=${RENEWED_LINEAGE:-}
[ -n "$lineage" ] || exit 0
if deploy_lineage "$lineage"; then
	maybe_reload
fi
