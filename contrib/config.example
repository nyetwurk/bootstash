# Example operator config. Do not copy this file over
# /etc/default/bootstash; add only the keys you need there.
# Google client id/secret: bootstash provision-google
# (writes /etc/bootstash/oidc-google, not this file).
#
# PUBLIC_ORIGIN=https://stash.example
# BIND=tun0:8443
# TLS_CERT=/etc/letsencrypt/live/stash.example/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/stash.example/privkey.pem
# ADMIN_USERS=alice
