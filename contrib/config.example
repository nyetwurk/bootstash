# Example overrides. Prefer the commented packaged values already in
# /etc/default/bootstash; do not copy this file over it.
# Google client JSON: bootstash provision-google
# (installs /etc/bootstash/oidc-google.json, not this file).
#
# BIND=tun0:8443
# PUBLIC_ORIGIN=https://stash.example
# CERT_NAME=stash.example
# TLS_CERT=/etc/bootstash/certs/stash.example/fullchain.pem
# TLS_KEY=/etc/bootstash/certs/stash.example/privkey.pem
# ADMIN_USERS=alice
